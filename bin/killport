#!/bin/bash
if [ -z "$1" ]; then
  echo "Open ports:"
  lsof -iTCP -sTCP:LISTEN -P -n | awk 'NR>1 {print $9, $1, $2}' | sed 's/.*://' | awk '{print "  :" $1 "\t" $2 "\t(PID " $3 ")"}' | sort -t: -k2 -n
  exit 0
fi
PIDS=$(lsof -ti:"$1")
if [ -z "$PIDS" ]; then
  echo "No process found on port $1"
  exit 1
fi
echo "$PIDS" | xargs kill -9 && echo "Killed process on port $1"