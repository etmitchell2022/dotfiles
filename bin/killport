#!/bin/bash
if [ -z "$1" ]; then
  echo "Open ports:"
  lsof -iTCP -sTCP:LISTEN -P -n | awk 'NR>1 {print $9, $1, $2}' | sed 's/.*://' | awk '{print "  :" $1 "\t" $2 "\t(PID " $3 ")"}' | sort -t: -k2 -n
  exit 0
fi
lsof -ti:"$1" | xargs kill -9 2>/dev/null && echo "Killed process on port $1" || echo "No process on port $1"